{
  "name": "pwtestdemo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean:allure": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "pretest": "npm run clean:allure",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "pretest:allure": "npm run clean:allure",
    "test:allure": "playwright test",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "npm run allure:generate && allure open allure-report",
    "allure:pdf": "node scripts/generate-allure-pdf.js",
    "allure:generate:pdf": "npm run allure:generate && npm run allure:pdf"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.5",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2"
  }
}
